# ==============================================================================
# إعدادات الربط مع Supabase
# ملحوظة: النظام يعمل تلقائياً بنمط المحاكاة المحلي (Local Mocking) إذا لم يتم توفير هذه المفاتيح
# ==============================================================================

# رابط مشروع Supabase الخاص بك
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# المفتاح العام (Anon / Publishable Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# اسم الـ Storage Bucket في Supabase لحفظ مرفقات الشكاوى
NEXT_PUBLIC_SUPABASE_BUCKET=complaint-media
