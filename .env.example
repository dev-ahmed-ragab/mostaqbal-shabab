# ==============================================================================
# إعدادات الربط مع Supabase
# ملحوظة: النظام يعمل تلقائياً بنمط المحاكاة المحلي (Local Mocking) إذا لم يتم توفير هذه المفاتيح
# ==============================================================================

# رابط مشروع Supabase الخاص بك
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# المفتاح العام (Anon / Publishable Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# اسم الـ Storage Bucket في Supabase لحفظ مرفقات الشكاوى
NEXT_PUBLIC_SUPABASE_BUCKET=complaint-media

# ==============================================================================
# دخول المشرف العام (كلمة سر واحدة - خادمي فقط، لا تستخدم NEXT_PUBLIC_)
# ==============================================================================

# كلمة السر الوحيدة لتسجيل الدخول
ADMIN_LOGIN_PASSWORD=change-me-to-a-strong-password

# مفتاح توقيع الجلسة (عشوائي، 32 حرفاً على الأقل)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# مدة الجلسة بالساعات (افتراضي 168 = 7 أيام)
ADMIN_SESSION_TTL_HOURS=168

